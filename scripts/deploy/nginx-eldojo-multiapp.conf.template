    location ~* \.(?:js|mjs|cjs|css|woff2?|ttf|eot|otf|png|jpg|jpeg|gif|svg|ico|webp|avif|map)$ {
        try_files $uri =404;
        access_log off;
        expires    1y;
        add_header Cache-Control "public, max-age=31536000, s-maxage=31536000, immutable" always;
    }

    # ================= HTML: NUNCA cachear =================
    location ~* \.(?:html|htm)$ {
