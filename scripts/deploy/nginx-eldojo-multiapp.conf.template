# ================= Redirect HTTP → HTTPS para los 3 dominios =================
server {
    listen 80;
    listen [::]:80;
    server_name eldojo.tech www.eldojo.tech app.eldojo.tech admin.eldojo.tech mi.eldojo.tech;

    # ===== Certbot http challenge =====
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}
